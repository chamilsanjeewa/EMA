{#
/**
 * @file
 * Status messages.
 */
#}
<div data-drupal-messages class="container">
{% for type, messages in message_list %}
  <div role="{{ type == 'error' ? 'alert' : 'status' }}" aria-label="{{ status_headings[type] }}" class="messages messages--{{ type }}">
    {% if messages|length > 1 %}
      <ul class="messages__list">{% for message in messages %}<li>{{ message }}</li>{% endfor %}</ul>
    {% else %}
      {{ messages|first }}
    {% endif %}
  </div>
{% endfor %}
</div>
